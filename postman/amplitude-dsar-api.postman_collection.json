                          }
                        ],
                        "body": {
                          "mode": "raw",
                          "raw": "{\n  \"amplitude_ids\": [\n    \"<long>\",\n    \"<long>\"\n  ],\n  \"user_ids\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"requester\": \"<string>\"\n}",
