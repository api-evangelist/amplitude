{
  "info": {
    "_postman_id": "4b0a3d7d-4e21-4f0c-b024-73134e326f20",
    "name": "Amplitude Data Subject Access Request API",
    "description": "The Amplitude Data Subject Access Request (DSAR) API enables organizations to programmatically handle privacy requests in compliance with GDPR, CCPA, and other data protection regulations. It supports submitting deletion requests for user data based on user IDs or device IDs, and retrieving all data associated with a user. This API allows companies to automate their privacy compliance workflows and ensure timely processing of data subject requests at scale.\n\nContact Support:\n Name: Amplitude Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-06-05T15:05:37.000Z",
    "updatedAt": "2026-06-05T15:05:37.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-4b0a3d7d-4e21-4f0c-b024-73134e326f20"
  },
