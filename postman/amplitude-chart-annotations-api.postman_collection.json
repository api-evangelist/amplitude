{
  "info": {
    "_postman_id": "816b5e68-42fc-4ca4-baab-00a8eb165cfc",
    "name": "Amplitude Chart Annotations API",
    "description": "The Amplitude Chart Annotations API enables developers to programmatically create, retrieve, update, and delete annotations on Amplitude charts. Annotations mark significant events such as product releases, marketing campaigns, or incidents on timeline-based charts. This API allows teams to automate annotation management as part of their deployment or release pipelines, ensuring that important context is always visible alongside analytics data.\n\nContact Support:\n Name: Amplitude Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-06-05T15:05:32.000Z",
