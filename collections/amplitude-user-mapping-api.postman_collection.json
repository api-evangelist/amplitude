        {
          "id": "2971b361-cb20-45d4-bd53-c131247ee77f",
          "name": "Amplitude Unmap User Identities",
          "request": {
            "name": "Amplitude Unmap User Identities",
            "description": {
              "content": "Reverse a previously created user identity mapping. After unmapping, the two identities are treated as separate users again. This does not retroactively separate events that were already merged.",
              "type": "text/plain"
            },
