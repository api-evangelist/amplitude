        {
          "id": "494efb63-2b0b-489d-b89c-347a876a724b",
          "name": "Amplitude Get Event Segmentation",
          "request": {
            "name": "Amplitude Get Event Segmentation",
            "description": {
              "content": "Get metrics for an event with segmentation. Returns event totals, unique users, or other metrics broken down by time intervals and optional segment or group-by properties.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "2",
                "events",
                "segmentation"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "e",
                  "value": "<string>",
                  "description": "(Required) A JSON-encoded event object with at minimum an event_type field. For funnel analysis, multiple e parameters define each funnel step."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<string>",
                  "description": "(Required) The start date in YYYYMMDD format."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "(Required) The end date in YYYYMMDD format."
                },
                {
                  "disabled": false,
                  "key": "m",
                  "value": "<string>",
                  "description": "The metric to compute. Options include uniques, totals, pct_dau, average, histogram, sums, value_avg, or formula."
                },
                {
                  "disabled": false,
                  "key": "i",
                  "value": "<integer>",
                  "description": "Time interval granularity. Use -300000 for real-time, 1 for daily, 7 for weekly, or 30 for monthly."
                },
                {
                  "disabled": false,
                  "key": "s",
                  "value": "<string>",
                  "description": "Segment definitions as a JSON-encoded array of segment objects for filtering results."
                },
                {
                  "disabled": false,
                  "key": "g",
                  "value": "<string>",
                  "description": "The property to group results by, such as a user property or event property name."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "The number of group-by values to return. Default is 100, max is 1000."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
