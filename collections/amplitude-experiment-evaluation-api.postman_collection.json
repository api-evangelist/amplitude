          "name": "Amplitude Evaluate Variants for a User",
          "request": {
            "name": "Amplitude Evaluate Variants for a User",
            "description": {
              "content": "Remotely evaluate all active experiments and feature flags for a specific user. Returns the variant assignments based on the user's properties and targeting rules. Amplitude automatically tracks an Experiment Assignment event for each evaluation.",
