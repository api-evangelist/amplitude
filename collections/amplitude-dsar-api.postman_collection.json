    "_postman_id": "f3715e68-8011-49d0-a0fa-1f4657d448af",
    "name": "Amplitude Data Subject Access Request API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Amplitude Data Subject Access Request (DSAR) API enables organizations to programmatically handle privacy requests in compliance with GDPR, CCPA, and other data protection regulations. It supports submitting deletion requests for user data based on user IDs or device IDs, and retrieving all data associated with a user. This API allows companies to automate their privacy compliance workflows and ensure timely processing of data subject requests at scale.\n\nContact Support:\n Name: Amplitude Support",
      "type": "text/plain"
    }
  }
