          "name": "Amplitude Get Retention Analysis",
          "request": {
            "name": "Amplitude Get Retention Analysis",
            "description": {
              "content": "Get user retention for specific starting and returning actions. Returns retention data broken down by cohort date showing the percentage of users who returned on each subsequent day.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "2",
                "retention"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "se",
                  "value": "<string>",
                  "description": "(Required) The starting event as a JSON-encoded object with event_type field."
                },
                {
                  "disabled": false,
                  "key": "re",
                  "value": "<string>",
                  "description": "(Required) The returning event as a JSON-encoded object with event_type field."
                },
                {
                  "disabled": false,
                  "key": "start",
                  "value": "<string>",
                  "description": "(Required) The start date in YYYYMMDD format."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<string>",
                  "description": "(Required) The end date in YYYYMMDD format."
                },
                {
                  "disabled": false,
                  "key": "rm",
                  "value": "<string>",
                  "description": "Retention mode. Use bracket for N-day retention or rolling for unbounded retention."
                },
                {
                  "disabled": false,
                  "key": "s",
                  "value": "<string>",
                  "description": "Segment definitions as a JSON-encoded array."
                }
              ],
