          "id": "e91bbb55-680f-4821-bcf8-c71ed46900ef",
          "name": "Amplitude Get a User Profile",
          "request": {
            "name": "Amplitude Get a User Profile",
            "description": {
              "content": "Retrieve the profile for a specific user including user properties, computed properties, cohort memberships, and personalized recommendations. The response includes all enriched data Amplitude has computed for the user.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "userprofile"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "user_id",
                  "value": "<string>",
                  "description": "(Required) The user_id of the user whose profile to retrieve."
                },
                {
                  "disabled": false,
                  "key": "comp_id",
                  "value": "<integer>",
                  "description": "The computed property ID or recommendation ID to retrieve specific computed results for the user."
                },
                {
                  "disabled": false,
                  "key": "get_recs",
                  "value": "false",
                  "description": "When true, include personalized recommendations in the response."
                },
                {
                  "disabled": false,
                  "key": "rec_id",
                  "value": "<string>",
                  "description": "The recommendation model ID to retrieve specific recommendation results."
                },
                {
                  "disabled": false,
                  "key": "rec_type",
                  "value": "<string>",
                  "description": "The type of recommendation to retrieve."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "The maximum number of recommendation results to return."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
